# Track the source release. Patient data and local working files stay on disk.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/config.json
!/movement_rule_protocol.md
!/pytest.ini
!/requirements.txt
!/requirements-lock.txt
!/Start_Project.ps1
!/Start_Project.bat
!/Start_Ollama.ps1
!/run_gait_analysis.py
!/verify_local_assistant.py

!/raycura/
/raycura/*
!/raycura/*.py
!/raycura/MYOGAIT_LICENSE.txt
# Historical Ridge experiment remains available to the local archive tests.
/raycura/ml.py

!/evidence/
/evidence/*
!/evidence/README.md
!/evidence/corpus.json
!/evidence/phase_angle_ranges.json

!/frontend/
/frontend/*
!/frontend/index.html
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/tsconfig.json
!/frontend/src/
/frontend/src/*
!/frontend/src/*.ts
!/frontend/src/*.tsx
!/frontend/src/*.css
!/frontend/public/
/frontend/public/*
!/frontend/public/better-logo.png
!/frontend/tests/
/frontend/tests/*
!/frontend/tests/assessment-browser.mjs

!/tests/
/tests/*
!/tests/conftest.py
!/tests/test_assessment_pdf.py
!/tests/test_assessment_workspace.py
!/tests/test_measurements.py
!/tests/test_myogait_rules.py
!/tests/test_prepared_dataset_208.py
!/tests/test_reference_policy_208.py
!/tests/test_rules_rag.py
